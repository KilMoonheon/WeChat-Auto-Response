# 复制为 config.yaml 后修改
# nickname = 微信聊天列表里的「备注名」或「昵称」（不是登录名）

settings:
  poll_interval: 1.0
  reply_cooldown: 180
  sync_mobile: false
  sync_wait: 0.8

contacts:
  文件传输助手:
    enabled: true
    allow_self: true
    reply_mode: keyword
    default: "收到，稍后回复您。"
    keywords:
      你好: "你好！有什么可以帮您？"
      在吗: "在的，请说。"

  好友昵称:
    enabled: true
    reply_mode: fixed
    default: "您好，我现在不在电脑旁，看到消息后会尽快回复。"
    # cooldown_seconds: 300
